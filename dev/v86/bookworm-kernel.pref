# Only take packages from bookworm that trixie lacks: the i386 kernel metapackage
# and its versioned image. Point releases and security updates are both considered.
Package: *
Pin: release n=bookworm
Pin-Priority: 100

Package: *
Pin: release n=bookworm-security
Pin-Priority: 100

Package: *
Pin: release n=bookworm-updates
Pin-Priority: 100
